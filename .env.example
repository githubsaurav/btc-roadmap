# Leave unset to run fully client-side on localStorage (default, no backend needed).
# Fill both in once a Supabase project exists — see supabase/schema.sql for the
# tables to create first — and the app switches to shared, cross-device progress
# automatically. No code changes required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
